# Supabase Configuration (New API Keys - June 2025+)
# Get these from your Supabase project settings > API
# Publishable key replaces legacy anon key
# Secret key replaces legacy service_role key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here
